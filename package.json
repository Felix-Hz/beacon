{
  "name": "beacon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types src/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/vitest-plugin": "1.8.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
